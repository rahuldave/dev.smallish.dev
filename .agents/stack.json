    ".pre-commit-config.yaml": {
      "repos[repo=local]": {
        "state": "added",
        "needs": [
          "tasker"
        ],
        "holder": "tasker",
        "value": {
          "repo": "local",
          "hooks": [
            {
              "id": "commit-gate",
              "name": "commit gate",
              "entry": "uv run --no-project --quiet --no-python-downloads --python '>=3.9' python .agents/skills/gcm/scripts/commit_gate.py",
              "language": "system",
              "pass_filenames": false,
              "always_run": true,
              "stages": [
                "pre-commit",
                "pre-merge-commit"
              ]
            },
            {
              "id": "commit-gate-trailer",
              "name": "commit gate trailer",
              "entry": "uv run --no-project --quiet --no-python-downloads --python '>=3.9' python .agents/skills/gcm/scripts/commit_gate.py --hook commit-msg",
              "language": "system",
              "always_run": true,
              "stages": [
                "commit-msg"
              ]
            },
            {
              "id": "just-ci",
              "name": "just ci",
              "entry": "uv run --no-project --quiet --no-python-downloads --python '>=3.9' python .agents/skills/gcm/scripts/pre_push.py",
              "language": "system",
              "pass_filenames": false,
              "always_run": true,
              "stages": [
                "pre-push"
              ]
            }
          ]
        }
      },
      "repos[repo=https://github.com/pre-commit/pre-commit-hooks]": {
        "state": "added",
        "needs": [
          "tasker"
        ],
        "holder": "tasker",
        "value": {
          "repo": "https://github.com/pre-commit/pre-commit-hooks",
          "rev": "v6.0.0",
          "hooks": [
            {
              "id": "check-yaml",
              "stages": [
